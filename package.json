{
  "name": "qaagent",
  "version": "1.6.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErickGomesSilva/qa-agent.git"
  },
  "homepage": "https://github.com/ErickGomesSilva/qa-agent",
  "bugs": {
    "url": "https://github.com/ErickGomesSilva/qa-agent/issues"
  },
  "private": true,
  "type": "module",
  "description": "QA Agent: requisitos → scripts Playwright → triagem LLM na falha",
  "bin": {
    "qaagent": "./bin/qaagent.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "cli": "tsx src/index.ts",
    "serve": "tsx src/index.ts --serve",
    "dev": "tsx watch --ignore ./data --ignore ./data/** src/index.ts --serve",
    "mcp:discord": "tsx src/discord-mcp.ts",
    "setup": "node instalar.mjs",
    "setup:hooks": "node scripts/setup-git-hooks.mjs",
    "security-check": "node scripts/security-check.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/roteiro.test.ts src/roteiro-cache.test.ts src/impediments.test.ts src/projects.test.ts src/req-source.test.ts src/fatal-summary.test.ts src/pause-guide.test.ts src/playwright-evidence.test.ts",
    "audit": "tsx src/audit-cli.ts",
    "reports": "tsx src/reports-cli.ts",
    "k6": "tsx src/k6-cli.ts",
    "deepen": "tsx src/deepen-cli.ts",
    "unblock-massa": "tsx src/unblock-cli.ts",
    "generate-massa": "tsx src/massa-cli.ts",
    "tour": "tsx src/tour-cli.ts",
    "postinstall": "node --import tsx src/post-install.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@playwright/test": "^1.55.0",
    "playwright-core": "^1.55.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
