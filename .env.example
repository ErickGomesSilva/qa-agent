# Só 127.0.0.1 se for usar a API HTTP (`npm run serve`).
HOST=127.0.0.1
PORT=8787

# Provedor: cursor | openai | anthropic | openrouter | groq | custom
# openai/openrouter/groq/custom = /v1/models + /v1/chat/completions + Bearer
# anthropic = API Claude (x-api-key + /v1/messages)
# LLM_BASE_URL: https://api.openai.com/v1 | https://openrouter.ai/api/v1 | https://api.groq.com/openai/v1 | https://api.anthropic.com/v1
LLM_PROVIDER=cursor
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Compatível com instalações antigas (o app também lê estes nomes).
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Agente local: HTTP/1.1 evita crash ECONNRESET no Windows (true = padrao).
CURSOR_USE_HTTP1=true

# Recorte da suíte. Vazio = todos os testes.
PLAYWRIGHT_GREP=@executavel

# Depois de classe TESTE + correção no locator, retoma a suíte.
AUTO_RESUME_ON_TESTE=true
TESTE_RESUME_LIMIT=5
# Seguir a suíte após triagem PRODUTO (grava o bug e continua). false = pausa.
CONTINUE_ON_PRODUTO=true
# true = próxima missão roda só os casos da quarentena (★).
RETEST_QUARANTINE=false

# Rebaixa @executavel stub para @rascunho na auditoria (true) ou só avisa (false + STRICT_COVERAGE=true falha).
AUTO_DOWNGRADE_STUBS=true
STRICT_COVERAGE=false

# deepen-stubs / unblock-massa / generate-massa
DEEPEN_LIMIT=15
MASSA_UNBLOCK_LIMIT=5
MASSA_GENERATE_LIMIT=10
MASSA_APPLY_LIMIT=5
MASSA_GENERATE_ENABLED=true
# MASSA_FILE=scripts/massa/dados.json

# Jornada no navegador (cliques como usuario)
TOUR_ENABLED=true
TOUR_HEADED=true
TOUR_MAX_ACTIONS=40
TOUR_SLOWMO=200
PLAYWRIGHT_HEADED=false
PLAYWRIGHT_VIDEO=off

# Paginas max no crawler por perfil (MAPA-PERFIL.json / MAPA-UI.json).
CRAWL_DEPTH=35

# Recorte do mapa/roteiro (mesmo motor geral vs focado). Arquivo: data/projects/<slug>/scripts/escopo.json
# QA_ESCOPO_MODO=focado
# QA_ESCOPO_LABELS=operador,visitante
# QA_ESCOPO_PATHS=/app/docs

# Pasta ativa em data/projects/<slug>/ (scripts, massa, relatórios). Senão: pasta dos requisitos (F3).
# QA_PROJECT=Portal-Rural

# Repo privado na F3 (clone HTTPS). Use o token do host, ou um genérico:
# QA_GIT_TOKEN=
# GITHUB_TOKEN=
# GITEA_TOKEN=
# AZURE_DEVOPS_PAT=
# GITLAB_TOKEN=
# BITBUCKET_TOKEN=


# k6 — smoke/carga HTTP apos Playwright passar (K6_ENABLED=true). Scripts em data/projects/<slug>/scripts/k6/
K6_ENABLED=false
K6_STRICT=false
K6_VUS=1
K6_DURATION=30s

# Opcional: Bearer para a API local.
QA_AGENT_TOKEN=

SETTING_SOURCES=project

# Idioma da interface: pt-BR | en-US (a TUI tambem grava em data/settings.json).
QA_LOCALE=pt-BR

# Webhook para notificar canal (Discord, Slack, Teams ou generico). So dispara em triagem PRODUTO.
WEBHOOK_URL=
WEBHOOK_PROVIDER=
# Compativel com instalacoes antigas (Discord):
DISCORD_WEBHOOK_URL=
