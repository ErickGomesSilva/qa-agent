{
  "mcpServers": {
    "discord": {
      "type": "stdio",
      "command": "node",
      "args": ["node_modules/tsx/dist/cli.mjs", "src/discord-mcp.ts"],
      "cwd": ".",
      "env": {
        "DISCORD_WEBHOOK_URL": "cole-no-.env-nao-aqui"
      }
    },
    "plane": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@makeplane/plane-mcp-server"],
      "env": {
        "PLANE_API_KEY": "cole-sua-chave-aqui-nao-commit",
        "PLANE_WORKSPACE_SLUG": "sua-workspace"
      }
    }
  }
}
